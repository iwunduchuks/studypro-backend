// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NoteDetailLevel {
  overview
  studyGuide
  detailed
}

enum ExerciseDetailLevel {
  shallow
  comprehensive
}

model Topic {
  id       String    @id
  title    String
  contexts Context[]
}

model Context {
  id        String     @id
  title     String
  content   String
  topicId   String
  topic     Topic      @relation(fields: [topicId], references: [id])
  notes     Note[]
  exercises Exercise[]

  @@index([topicId])
}

model Note {
  id          String          @id
  content     String
  contextId   String
  context     Context         @relation(fields: [contextId], references: [id])
  order       Int
  detailLevel NoteDetailLevel

  @@index([contextId])
}

model Exercise {
  id          String              @id
  question    String
  answer      String
  contextId   String
  context     Context             @relation(fields: [contextId], references: [id])
  order       String
  detailLevel ExerciseDetailLevel

  @@index([contextId])
}
